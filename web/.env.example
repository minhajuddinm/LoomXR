# Copy to .env.local and fill in. .env.local is git-ignored. Never commit keys.

# Supabase (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Stripe, TEST MODE keys only (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Printed by `pnpm seed:stripe`.
STRIPE_PORTAL_CONFIGURATION_ID=

# Comma-separated emails allowed to open /admin pages
ADMIN_EMAILS=

# Used from Phase 2 and 3
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Shared secret for /api/cron/* (Phase 6)
CRON_SECRET=

# Demo mode: no login, one shared demo business. Never enable in production.
DEMO_MODE=

# Optional model overrides
TOGETHER_IMAGE_MODEL=
TOGETHER_TEXT_MODEL=
